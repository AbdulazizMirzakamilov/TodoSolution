<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Todo.Core</PackageId>
    <Version>0.2.0</Version>
    <Authors>AbdulazizMirzakamilov</Authors>
    <Company>io.natk</Company>
    <Description>Simple Todo core library (for practice)</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/AbdulazizMirzakamilov/TodoSolution</RepositoryUrl>
    <PackageProjectUrl>https://github.com/AbdulazizMirzakamilov/TodoSolution</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
